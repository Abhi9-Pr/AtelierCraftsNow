# Copy this file to .env and fill in the values. .env is never committed.

# Web3Forms access key (the default form relay).
# Free key from https://web3forms.com: enter the email address that should
# receive requests and the key is sent to it. It is a public client key by
# design, so it is safe for it to end up in the built site.
VITE_FORM_ACCESS_KEY=9c2b523c-dfa0-43ff-99ed-01d9044f2ca8

# Optional. The public site key of a Cloudflare Turnstile widget, to add a spam check to the
# request form. Turnstile must also be switched on in the order functions with TURNSTILE_SECRET
# (see docs/SETUP.md, "Orders and the dashboard"). Set both, or neither.
VITE_TURNSTILE_SITE_KEY=

# Optional. The site token of a Cloudflare Web Analytics site, to count visitors. It is in the
# snippet Cloudflare shows you: the value after "token". Public by design. See docs/ANALYTICS.md.
VITE_WEB_ANALYTICS_TOKEN=

# Only needed if you switch to the Formspree relay (see docs/SETUP.md).
# The id is the part after /f/ in your form's endpoint URL.
VITE_FORMSPREE_FORM_ID=
